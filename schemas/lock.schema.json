{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agx.dev/schemas/lock.schema.json",
  "title": "AGX Milestone 1 Lockfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "catalogDigest", "skills"],
  "properties": {
    "apiVersion": { "const": "agx.dev/v1alpha1" },
    "kind": { "const": "Lockfile" },
    "catalogDigest": { "$ref": "#/$defs/digest" },
    "skills": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/lockedSkill" }
    },
    "instructions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/lockedInstruction" }
    },
    "mcpServers": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/lockedMCPServer" }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lockedSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "contentDigest", "lockedAt"],
      "properties": {
        "source": {
          "oneOf": [
            { "$ref": "#/$defs/lockedLocalSource" },
            { "$ref": "#/$defs/lockedGitSource" }
          ]
        },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "overlayDigest": { "$ref": "#/$defs/digest" },
        "lockedAt": { "type": "string", "format": "date-time" }
      }
    },
    "lockedInstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "content", "contentDigest", "lockedAt"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "contentDigest"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "contentDigest": { "$ref": "#/$defs/digest" }
            }
          }
        },
        "content": { "type": "string", "minLength": 1 },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "lockedAt": { "type": "string", "format": "date-time" }
      }
    },
    "lockedMCPServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "command", "targets", "lockedAt"],
      "properties": {
        "transport": { "const": "stdio" },
        "command": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executable"],
          "properties": {
            "executable": { "type": "string", "minLength": 1 },
            "args": { "type": "array", "items": { "type": "string" } }
          }
        },
        "environment": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/environmentName" },
          "additionalProperties": { "$ref": "#/$defs/environmentReference" }
        },
        "targets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "codex": { "$ref": "#/$defs/target" }
          }
        },
        "lockedAt": { "type": "string", "format": "date-time" }
      }
    },
    "environmentName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "environmentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "name"],
      "properties": {
        "from": { "const": "env" },
        "name": { "$ref": "#/$defs/environmentName" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "lockedLocalSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": { "const": "local" },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Original Catalog-relative, absolute, or ~/ user-home path for a local Skill."
        }
      }
    },
    "lockedGitSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repository", "requestedRevision", "resolvedCommit"],
      "properties": {
        "type": { "const": "git" },
        "repository": { "type": "string", "minLength": 1 },
        "requestedRevision": { "type": "string", "minLength": 1 },
        "resolvedCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "type": "string" }
      }
    }
  }
}
